# OCR images are sent to the configured third-party model service.
# Do not submit identity documents, credentials, private chats, or other sensitive images.
# Store the real API key only in a local ignored environment file.

SILICONFLOW_API_KEY=
QQBOT_OCR_PROVIDER=siliconflow
QQBOT_OCR_MODEL=deepseek-ai/DeepSeek-OCR
QQBOT_OCR_MODE=plain_text
QQBOT_OCR_BASE_URL=https://api.siliconflow.cn/v1
QQBOT_OCR_TIMEOUT_MS=60000
QQBOT_OCR_MAX_IMAGE_MB=10
QQBOT_OCR_MAX_OUTPUT_CHARS=6000
